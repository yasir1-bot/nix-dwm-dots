# theme.nix — wallpaper in, colours out. Everything happens at BUILD time.
#
# Why not the referenced Fuwn/pywal.nix? It is a Home Manager module that needs flake-compat and
# builds four extra colour back-ends on every evaluation (some from git with submodules) — more
# moving parts than this setup wants. It does exactly what the next 12 lines do: run pywal once
# inside the Nix sandbox and read the JSON result back. We do that with nixpkgs' own `pywal16`.
{ pkgs
, wallpaper
, light ? false
, backend ? "wal"
, contrast ? "4.5"   # pywal guarantees at least this contrast ratio of every colour vs the background
}:

let
  inherit (pkgs) lib;

  # A tiny derivation that runs: wal -i <wallpaper>  and keeps colors.json.
  #  -n no wallpaper setting   -s/-t don't recolour terminals/ttys   -e don't reload other programs
  #  --contrast keeps every colour readable on the background, whatever the picture looks like
  generated = pkgs.runCommand "pywal-colors.json"
    { nativeBuildInputs = [ pkgs.pywal16 pkgs.imagemagick ]; }
    ''
      export HOME="$TMPDIR"        # wal writes ~/.cache/wal; the sandbox has no real home
      wal -i ${wallpaper} -n -s -t -e -q --backend ${backend} --contrast ${contrast} ${lib.optionalString light "-l"}
      cp "$HOME/.cache/wal/colors.json" "$out"
    '';

  scheme = builtins.fromJSON (builtins.readFile generated);   # reading a build result = "IFD"
  c = scheme.colors;

  # Few named ROLES that every program uses. Remap colours for the whole desktop right here.
  roles = {
    bg     = scheme.special.background;
    fg     = scheme.special.foreground;
    dim    = c.color8;     # borders, comments, inactive things
    accent = c.color4;     # selected tag, selected menu entry, focused border
    urgent = c.color1;
  };

  # C header included by dwm, dmenu and st (see suckless.nix).
  colorsH = pkgs.writeText "colors.h" ''
    /* generated by theme.nix from the wallpaper — do not edit */
    ${lib.concatStringsSep "\n" (lib.mapAttrsToList (n: v: ''#define col_${n} "${v}"'') roles)}
    ${lib.concatMapStringsSep "\n" (i: ''#define WAL_COLOR${toString i} "${c."color${toString i}"}"'') (lib.range 0 15)}
  '';

  # Neovim highlight groups (Lua). Normal has no background so terminal transparency shows through.
  groups = {
    Normal       = { fg = roles.fg; };
    NormalFloat  = { fg = roles.fg; bg = roles.bg; };
    Comment      = { fg = roles.dim; italic = true; };
    Constant     = { fg = c.color3; };
    String       = { fg = c.color2; };
    Number       = { fg = c.color3; };
    Identifier   = { fg = roles.fg; };
    Function     = { fg = c.color4; };
    Statement    = { fg = c.color5; };
    Keyword      = { fg = c.color5; };
    PreProc      = { fg = c.color6; };
    Type         = { fg = c.color6; };
    Special      = { fg = c.color6; };
    Delimiter    = { fg = roles.dim; };
    LineNr       = { fg = roles.dim; };
    CursorLineNr = { fg = roles.accent; bold = true; };
    CursorLine   = { };           # only the line NUMBER is highlighted (see cursorlineopt)
    Visual       = { bg = roles.dim; };
    Search       = { fg = roles.bg; bg = roles.accent; };
    IncSearch    = { fg = roles.bg; bg = roles.urgent; };
    MatchParen   = { fg = roles.accent; bold = true; };
    Pmenu        = { fg = roles.fg; bg = roles.bg; };
    PmenuSel     = { fg = roles.bg; bg = roles.accent; };
    StatusLine   = { fg = roles.fg; bg = roles.bg; };
    StatusLineNC = { fg = roles.dim; bg = roles.bg; };
    VertSplit    = { fg = roles.dim; };
    WinSeparator = { fg = roles.dim; };
    SignColumn   = { };
    ErrorMsg     = { fg = roles.urgent; };
    WarningMsg   = { fg = c.color3; };
    Directory    = { fg = roles.accent; };
    Title        = { fg = roles.accent; bold = true; };
    NonText      = { fg = roles.dim; };
    EndOfBuffer  = { fg = roles.bg; };
  };

  nvimColors = pkgs.writeText "pywal-colors.lua" ''
    vim.cmd("highlight clear")
    vim.g.colors_name = "pywal"
    vim.o.termguicolors = true
    ${lib.concatStringsSep "\n" (lib.mapAttrsToList
      (name: attrs: ''vim.api.nvim_set_hl(0, "${name}", ${lib.generators.toLua { } attrs})'') groups)}
  '';
in
{
  inherit scheme roles colorsH nvimColors wallpaper;
}
